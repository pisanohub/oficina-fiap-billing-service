{
  "info": {
    "name": "Billing - orçamento local",
    "description": "Executar com perfil local, sem AWS/JWT. Dados fictícios; contrato SQS ainda pendente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8082"},
    {"key": "comandoId", "value": "11111111-1111-4111-8111-111111111111"},
    {"key": "orcamentoId", "value": ""}
  ],
  "auth": {"type": "noauth"},
  "item": [
    {
      "name": "1 - Gerar (repetição mantém o ID)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/internal/orcamentos",
        "body": {"mode": "raw", "raw": "{\n  \"comandoId\": \"{{comandoId}}\",\n  \"ordemId\": 1,\n  \"clienteId\": 1,\n  \"itens\": [\n    {\"referencia\":\"oleo\",\"tipo\":\"PECA\",\"descricao\":\"Óleo\",\"quantidade\":2,\"valorUnitario\":49.90},\n    {\"referencia\":\"mao-obra\",\"tipo\":\"SERVICO\",\"descricao\":\"Troca de óleo\",\"quantidade\":1,\"valorUnitario\":100.00}\n  ]\n}", "options": {"raw": {"language": "json"}}}
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "if (pm.response.code === 200) {",
        "  const body = pm.response.json();",
        "  pm.collectionVariables.set('orcamentoId', body.id);",
        "  pm.test('Total calculado', () => pm.expect(body.total).to.eql(199.8));",
        "}"
      ]}}]
    },
    {
      "name": "2 - Consultar salvo",
      "request": {"method": "GET", "url": "{{baseUrl}}/internal/orcamentos/{{orcamentoId}}"},
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]}}]
    },
    {
      "name": "3 - Rejeitar quantidade zero",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/internal/orcamentos",
        "body": {"mode": "raw", "raw": "{\"comandoId\":\"{{$guid}}\",\"ordemId\":1,\"clienteId\":1,\"itens\":[{\"referencia\":\"teste\",\"tipo\":\"SERVICO\",\"descricao\":\"Teste\",\"quantidade\":0,\"valorUnitario\":10.00}]}", "options": {"raw": {"language": "json"}}}
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));"]}}]
    }
  ]
}
